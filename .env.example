# Скопируй этот файл в .env и впиши свои значения.
# Сам .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Anthropic API: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Часовой пояс пользователей (по умолчанию Europe/Moscow)
BOT_TIMEZONE=Europe/Moscow

# Путь к файлу базы (по умолчанию calories.db рядом с ботом)
# DB_PATH=/data/calories.db
